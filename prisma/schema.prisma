generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT_CENTRE
  RESPONSABLE_STOCK
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  password  String
  role      Role     @default(AGENT_CENTRE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

